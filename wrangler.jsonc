{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgepilot-ai-architecture-advisor",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": true,
  "ai": { "binding": "AI" },
  "vars": { "AI_GATEWAY_ID": "default" },
  "observability": { "enabled": true }
}
